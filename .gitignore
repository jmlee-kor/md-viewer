# dev 전용 — 폐쇄망에는 git pull 로만 반입하므로 아래는 커밋하지 않음
node_modules/
dist/
out/

# Electron prebuilt 캐시 (Chromium) — 수동 반입 대상이라 repo 에 넣지 않음
.electron-cache/
# 폐쇄망에 수동 반입하는 Electron prebuilt 압축 해제 위치
electron/

# OS / 에디터
Thumbs.db
.DS_Store
*.log

# 단, vendor/ 는 의도적으로 커밋한다 (오프라인 배포 핵심).
# 아래 negation 으로 vendor 하위가 위 규칙에 안 걸리게 보장.
!vendor/
!vendor/**

# tools/ 의 반입 바이너리(JRE/plantuml.jar/graphviz)는 커밋하지 않음 (README 만 유지)
tools/*
!tools/README.md

# 로컬 설정 (java/jar/dot 경로) — PC 별로 다름
mdv.config.json

# 대용량 vault 성능 측정용 합성 데이터 (gen-large-vault.cjs)
.large-vault/
